# Required for answer generation and advanced retrieval graders
OPENAI_API_KEY=your_openai_api_key_here

# Optional LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=document-intelligence-rag
# Legacy variable names are also supported by LangChain:
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=document-intelligence-rag
